generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  ADMIN
  MEDICO
  RECEPCIONISTA
}

enum Genero {
  FEMENINO
  MASCULINO
  NO_BINARIO
  NO_ESPECIFICA
  OTRO
}

enum Especialidad {
  CARDIOLOGIA
  CLINICA_MEDICA
  DERMATOLOGIA
  GINECOLOGIA
  NEUROLOGIA
  OFTALMOLOGIA
  OTRA
  PEDIATRIA
  PSIQUIATRIA
  TRAUMATOLOGIA
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum EstadoTurno {
  PENDIENTE
  CONFIRMADO
  ATENDIDO
  CANCELADO
  AUSENTE
}

enum NombreObraSocial {
  ACCORD_SALUD
  AVALIAN
  GALENO
  HOMINIS
  HOSPITAL_ITALIANO
  IOMA
  LUIS_PASTEUR
  MEDICUS
  MEDIFE
  OMINT
  OSAPM
  OSBA
  OSCHOCA
  OSDE
  OSDEPYM
  OSECAC
  OSFATLYF
  OSFFENTOS
  OSPE
  OSPACA
  OSPAT
  OSPEDYC
  OSPERYH
  OSPIA
  OSPIC
  OSPIL
  OSPIM
  OSPJN
  OSPLAD
  OSPOCE
  OSPSA
  OSSEG
  OSUTHGRA
  OTRA
  PAMI
  PREVENCION_SALUD
  SANCOR_SALUD
  SIN_COBERTURA
  SWISS_MEDICAL
  UNION_PERSONAL
}

model Institucion {
  id        Int     @id @default(autoincrement())
  nombre    String
  direccion String?
  telefono  String?
  email     String?
  activo    Boolean @default(true)
}

model Usuario {
  id            Int        @id @default(autoincrement())
  nombreUsuario String     @unique
  passwordHash  String
  rol           RolUsuario @default(RECEPCIONISTA)
  activo        Boolean    @default(true)
}

model Medico {
  legajo               Int        @id @default(autoincrement())
  nombre               String
  activo               Boolean    @default(true)
  telefono             String?
  telefonoDeEmergencia String?
  email                String?
  fechaDeNacimiento    DateTime?
  genero               Genero?
  domicilio            String?
  matricula            String     @unique
  rol                  RolUsuario @default(MEDICO)

  especialidades MedicoEspecialidad[]
  horarios       HorarioMedico[]
  bloqueosAgenda BloqueoAgendaMedico[]
  turnos         Turno[]
  consultas      Consulta[]
  tratamientos   Tratamiento[]
}

model MedicoEspecialidad {
  id           Int          @id @default(autoincrement())
  especialidad Especialidad
  legajoMedico Int
  medico       Medico       @relation(fields: [legajoMedico], references: [legajo], onDelete: Cascade)

  @@unique([legajoMedico, especialidad])
  @@index([legajoMedico])
  @@index([especialidad])
}

model HorarioMedico {
  id         Int       @id @default(autoincrement())
  diaSemana  DiaSemana
  horaInicio DateTime  @db.Time(0)
  horaFin    DateTime  @db.Time(0)
  activo     Boolean   @default(true)

  legajoMedico Int
  medico       Medico @relation(fields: [legajoMedico], references: [legajo], onDelete: Cascade)

  @@unique([legajoMedico, diaSemana, horaInicio, horaFin])
  @@index([legajoMedico, diaSemana])
}

model BloqueoAgendaMedico {
  id          Int      @id @default(autoincrement())
  fechaInicio DateTime
  fechaFin    DateTime
  motivo      String?

  legajoMedico Int
  medico       Medico @relation(fields: [legajoMedico], references: [legajo], onDelete: Cascade)

  @@index([legajoMedico, fechaInicio, fechaFin])
}

model Paciente {
  dni                  Int       @id
  nombre               String
  telefono             String?
  telefonoDeEmergencia String?
  email                String?
  fechaDeNacimiento    DateTime?
  genero               Genero?
  domicilio            String?

  historiaClinica HistoriaClinica?
  obraSocial      ObraSocial?
  turnos          Turno[]
}

model ObraSocial {
  id               Int              @id @default(autoincrement())
  nombre           NombreObraSocial
  numeroDeAfiliado String?
  plan             String?
  dniPaciente      Int              @unique
  paciente         Paciente         @relation(fields: [dniPaciente], references: [dni], onDelete: Cascade)
}

model HistoriaClinica {
  expediente  Int      @id @default(autoincrement())
  dniPaciente Int      @unique
  paciente    Paciente @relation(fields: [dniPaciente], references: [dni], onDelete: Cascade)

  consultas    Consulta[]
  tratamientos Tratamiento[]
  antecedentes Antecedente[]
  documentos   Documento[]
}

model Turno {
  numeroTurno   Int          @id @default(autoincrement())
  fechaInicio   DateTime
  fechaFin      DateTime
  estado        EstadoTurno  @default(PENDIENTE)
  especialidad  Especialidad
  motivo        String?
  observaciones String?

  dniPaciente Int
  paciente    Paciente @relation(fields: [dniPaciente], references: [dni], onDelete: Restrict)

  legajoMedico Int
  medico       Medico @relation(fields: [legajoMedico], references: [legajo], onDelete: Restrict)

  consulta Consulta?

  @@index([legajoMedico, fechaInicio])
  @@index([legajoMedico, fechaFin])
  @@index([dniPaciente, fechaInicio])
  @@index([especialidad, fechaInicio])
  @@index([estado])
}

model Consulta {
  numeroConsulta Int @id @default(autoincrement())

  numeroExpediente Int
  historiaClinica  HistoriaClinica @relation(fields: [numeroExpediente], references: [expediente], onDelete: Cascade)

  fecha         DateTime
  diagnostico   String
  observaciones String?

  legajoMedico Int
  medico       Medico @relation(fields: [legajoMedico], references: [legajo], onDelete: Restrict)

  numeroTurno Int?   @unique
  turno       Turno? @relation(fields: [numeroTurno], references: [numeroTurno], onDelete: SetNull)

  @@index([numeroExpediente])
  @@index([legajoMedico])
  @@index([fecha])
}

model Tratamiento {
  numeroTratamiento Int @id @default(autoincrement())

  numeroExpediente Int
  historiaClinica  HistoriaClinica @relation(fields: [numeroExpediente], references: [expediente], onDelete: Cascade)

  descripcion String
  fechaInicio DateTime
  fechaFin    DateTime

  legajoMedico Int
  medico       Medico @relation(fields: [legajoMedico], references: [legajo], onDelete: Restrict)

  @@index([numeroExpediente])
  @@index([legajoMedico])
}

model Antecedente {
  id Int @id @default(autoincrement())

  numeroExpediente Int
  historiaClinica  HistoriaClinica @relation(fields: [numeroExpediente], references: [expediente], onDelete: Cascade)

  tipo        String
  descripcion String

  @@index([numeroExpediente])
}

model Documento {
  numeroDocumento Int @id @default(autoincrement())

  numeroExpediente Int
  historiaClinica  HistoriaClinica @relation(fields: [numeroExpediente], references: [expediente], onDelete: Cascade)

  tipo           String
  archivo        String
  nombreOriginal String
  mimeType       String
  tamanio        Int
  fecha          DateTime

  @@index([numeroExpediente])
}
