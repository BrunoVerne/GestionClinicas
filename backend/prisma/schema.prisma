generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  ADMIN
  MEDICO
  RECEPCIONISTA
}

model Institucion {
  id        Int     @id @default(autoincrement())
  nombre    String
  direccion String?
  telefono  String?
  email     String?
  activo    Boolean @default(true)
}

model Usuario {
  id            Int        @id @default(autoincrement())
  nombreUsuario String     @unique
  passwordHash  String
  rol           RolUsuario @default(RECEPCIONISTA)
  activo        Boolean    @default(true)
}

model Medico {
  legajo       Int     @id @default(autoincrement())
  nombre       String
  activo       Boolean @default(true)
  especialidad String

  consultas    Consulta[]
  tratamientos Tratamiento[]
}

model Paciente {
  dni    Int    @id
  nombre String
  peso   Float
  altura Float

  historiaClinica HistoriaClinica?
}

model HistoriaClinica {
  expediente Int @id @default(autoincrement())

  dniPaciente Int   @unique
  paciente    Paciente @relation(fields: [dniPaciente], references: [dni], onDelete: Cascade)

  consultas    Consulta[]
  tratamientos Tratamiento[]
  antecedentes Antecedente[]
  documentos   Documento[]
}

model Consulta {
  numeroConsulta Int @id @default(autoincrement())

  numeroExpediente Int
  historiaClinica HistoriaClinica @relation(fields: [numeroExpediente], references: [expediente], onDelete: Cascade)

  fecha         DateTime
  motivo        String
  diagnostico   String
  observaciones String?

  legajoMedico Int
  medico       Medico @relation(fields: [legajoMedico], references: [legajo], onDelete: Restrict)

  @@index([numeroExpediente])
  @@index([legajoMedico])
  @@index([fecha])
}

model Tratamiento {
  numeroTratamiento Int @id @default(autoincrement())

  numeroExpediente Int
  historiaClinica HistoriaClinica @relation(fields: [numeroExpediente], references: [expediente], onDelete: Cascade)

  descripcion String
  fechaInicio DateTime
  fechaFin    DateTime

  legajoMedico Int
  medico       Medico @relation(fields: [legajoMedico], references: [legajo], onDelete: Restrict)

  @@index([numeroExpediente])
  @@index([legajoMedico])
}

model Antecedente {
  id Int @id @default(autoincrement())

  numeroExpediente Int
  historiaClinica HistoriaClinica @relation(fields: [numeroExpediente], references: [expediente], onDelete: Cascade)

  tipo        String
  descripcion String

  @@index([numeroExpediente])
}

model Documento {
  numeroDocumento Int @id @default(autoincrement())

  numeroExpediente Int
  historiaClinica HistoriaClinica @relation(fields: [numeroExpediente], references: [expediente], onDelete: Cascade)

  tipo          String
  archivo       String
  nombreOriginal String
  mimeType       String
  tamanio        Int
  fecha          DateTime

  @@index([numeroExpediente])
}